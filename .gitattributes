# Keep line endings identical on Windows, macOS and Linux
* text=auto
*.ipynb text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.png   binary
# CSV files are left to Git's default handling; the notebook's data fingerprint
# ignores line endings, so the checksum is the same on every system.
